# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Supabase PostgreSQL Database Settings
# Format: postgresql+asyncpg://postgres:<password>@db.<project_ref>.supabase.co:5432/postgres
SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres:your_supabase_password@db.your_project_ref.supabase.co:5432/postgres
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Prodamus Payment Gateway Settings
PRODAMUS_SECRET_KEY=your_prodamus_secret_key_here
PRODAMUS_PAYMENT_URL=https://yourshop.payform.ru

# OpenAI ChatGPT Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Redis & Async Background Workers
REDIS_URL=redis://localhost:6379/0

# Server & Application Settings
ENVIRONMENT=development
SECRET_KEY=generate_random_secret_key_here
WEBHOOK_DOMAIN=https://your-domain.com
PORT=8000

# Admin Users Configuration (comma-separated Telegram usernames without @)
ADMIN_USERNAMES=astihakun,astikkhakun,sherlockdxb
